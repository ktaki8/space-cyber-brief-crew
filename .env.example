# Hosted model (default). Needs a key; CrewAI picks a default model if MODEL is unset.
OPENAI_API_KEY=sk-your-key-here
# MODEL=gpt-4o-mini

# Local model instead (no key, no internet): install Ollama, run `ollama pull llama3.1:8b`,
# then uncomment these two lines. The OpenAI key above is then ignored.
# MODEL=ollama/llama3.1:8b
# API_BASE=http://localhost:11434

# Optional: default source folder for main.py and the API (otherwise sources/)
# BRIEF_SOURCES_DIR=corpora/live

# Web API only: secret required in the X-Access-Key header for POST /api/run-crew
# CREW_ACCESS_KEY=replace-with-a-long-random-string
